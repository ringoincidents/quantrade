FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir urllib3==2.8.0
COPY verification/private-office/portfolio_projection.py verification/private-office/broker_reader.py verification/private-office/test_broker_reader.py verification/private-office/link_transport.py verification/private-office/link_gateway.py verification/private-office/test_link.py ./
RUN python -m unittest -v test_link test_broker_reader
USER 65534:65534
CMD ["python","-B","/app/link_gateway.py"]
